{
  "version": 2,
  "routes": [
    {
      "src": "/",
      "dest": "/templates/index.html"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/static/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/templates/$1"
    }
  ]
}